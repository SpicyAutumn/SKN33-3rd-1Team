# 실제 키를 입력하지 말고 필요한 환경 변수 이름만 관리합니다.
AKS_API_KEY={{your_aks_openapi_key}}
AKS_API_BASE_URL=https://devin.aks.ac.kr:8080/api

OPENAI_API_KEY={{your_openai_api_key}}
OPENAI_CHAT_MODEL={{team_selected_chat_model}}
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 수업에서 사용한 Pinecone을 선택할 경우
PINECONE_API_KEY={{your_pinecone_api_key}}
PINECONE_INDEX_NAME={{team_index_name}}
# 비어 있으면 Pinecone 기본 namespace(v1)를 사용합니다.
PINECONE_NAMESPACE=

# E의 서비스 RAG Chain 기준값. top_k=3은 현재 검색 평가 Baseline이며, 5는 후속 실험에서 비교합니다.
# 점수 임계값은 Dev set으로 보정한 뒤 1차 거름망으로만 사용합니다.
RAG_TOP_K=3
RAG_MIN_RETRIEVAL_SCORE=

# LangSmith 추적을 사용할 경우에만 설정
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY={{your_langsmith_api_key}}
LANGSMITH_PROJECT={{team_project_name}}
